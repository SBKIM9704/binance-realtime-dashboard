# Binance REST/WS endpoints (public market data — no API key required)
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443

# Symbols to collect (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT

# Kline interval to collect and store (1s, 1m, 3m, 5m, 15m, 1h)
KLINE_INTERVAL=1s

# On first run (empty DB) how many days of history to backfill
BACKFILL_DAYS=3

# How often the reconciler scans for and fills missing candles (ms)
RECONCILE_INTERVAL_MS=60000

# How far back the reconciler scans for gaps each run (ms). Default 30m.
RECONCILE_WINDOW_MS=1800000

# Delete klines/events older than this many days (caps DB growth at 1s)
RETENTION_DAYS=7

# SQLite database file path
DB_PATH=./data/market.db

# --- REST rate-limit safeguards ---
# Delay between paginated backfill requests (ms) so large backfills never burst
REST_THROTTLE_MS=250
# Max retries per REST call on 429/418/5xx before giving up
REST_MAX_RETRIES=4
# Binance IP weight budget per minute (REQUEST_WEIGHT). Real value is 6000.
REST_WEIGHT_LIMIT=6000
# Fraction of the budget at which we proactively pace requests (0.1–1.0)
REST_WEIGHT_SOFT_PCT=0.8
